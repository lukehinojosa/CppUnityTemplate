* text=auto
*.cs text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.yml text eol=lf

# Unity YAML: merge as text, never normalise line endings mid-file
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf

